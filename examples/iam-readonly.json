{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadMetadataAcrossServices",
      "Effect": "Allow",
      "Action": [
        "acm:Describe*", "acm:List*",
        "apigateway:GET",
        "autoscaling:Describe*",
        "backup:Describe*", "backup:List*",
        "budgets:Describe*", "budgets:View*",
        "ce:Get*", "ce:List*", "ce:Describe*",
        "cloudformation:Describe*", "cloudformation:List*", "cloudformation:Get*",
        "cloudfront:Get*", "cloudfront:List*",
        "cloudtrail:Describe*", "cloudtrail:Get*", "cloudtrail:List*", "cloudtrail:LookupEvents",
        "cloudwatch:Describe*", "cloudwatch:Get*", "cloudwatch:List*",
        "config:Describe*", "config:Get*", "config:List*",
        "dynamodb:Describe*", "dynamodb:List*",
        "ec2:Describe*", "ec2:Get*",
        "ecr:Describe*", "ecr:List*",
        "ecs:Describe*", "ecs:List*",
        "eks:Describe*", "eks:List*",
        "elasticache:Describe*", "elasticache:List*",
        "elasticloadbalancing:Describe*",
        "events:Describe*", "events:List*",
        "guardduty:Get*", "guardduty:List*", "guardduty:Describe*",
        "iam:Get*", "iam:List*", "iam:Simulate*",
        "kms:Describe*", "kms:List*", "kms:Get*",
        "lambda:Get*", "lambda:List*",
        "logs:Describe*", "logs:Get*", "logs:FilterLogEvents", "logs:StartQuery", "logs:GetQueryResults",
        "organizations:Describe*", "organizations:List*",
        "rds:Describe*", "rds:List*",
        "route53:Get*", "route53:List*",
        "s3:GetBucket*", "s3:ListAllMyBuckets", "s3:ListBucket",
        "securityhub:Get*", "securityhub:List*", "securityhub:Describe*",
        "sns:Get*", "sns:List*",
        "sqs:Get*", "sqs:List*",
        "ssm:Describe*", "ssm:List*",
        "states:Describe*", "states:List*",
        "sts:GetCallerIdentity",
        "tag:Get*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "NeverReadSecretsOrCode",
      "Effect": "Deny",
      "Action": [
        "secretsmanager:GetSecretValue",
        "secretsmanager:BatchGetSecretValue",
        "ssm:GetParameter*",
        "kms:Decrypt",
        "ec2:GetPasswordData",
        "lambda:GetFunction",
        "s3:GetObject*"
      ],
      "Resource": "*"
    }
  ]
}
